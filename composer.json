{
    "name": "taoshan98/quill-markdown",
    "description": "Bidirectional Quill Delta and Markdown (GFM) converter for PHP",
    "keywords": ["quill", "quilljs", "delta", "quill-delta", "markdown", "gfm", "bidirectional", "converter", "wysiwyg"],
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Taoshan",
            "email": "taoshan98@gmail.com"
        }
    ],
    "replace": {
        "taoshan98/markdown-to-quill-delta": "self.version"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Taoshan\\QuillMarkdown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Taoshan\\QuillMarkdown\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
